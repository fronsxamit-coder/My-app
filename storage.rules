rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Chat uploads: any signed-in user, max 50 MB per file.
    match /rooms/{rid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 50 * 1024 * 1024;
    }
  }
}
