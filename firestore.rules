rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /servers/{sid} {
      allow read: if signedIn();   // needed so invite codes can be looked up
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      // owner edits anything; anyone may add/remove only themselves
      allow update: if signedIn() && (
        resource.data.owner == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
      );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    function canAccessRoom(rid) {
      let r = get(/databases/$(db)/documents/rooms/$(rid)).data;
      return (r.type == 'channel' &&
              request.auth.uid in get(/databases/$(db)/documents/servers/$(r.serverId)).data.members)
          || (r.type != 'channel' && request.auth.uid in r.members);
    }

    match /rooms/{rid} {
      allow read: if signedIn() && (
        (resource.data.type == 'channel' &&
          request.auth.uid in get(/databases/$(db)/documents/servers/$(resource.data.serverId)).data.members)
        || (resource.data.type != 'channel' && request.auth.uid in resource.data.members));
      allow create: if signedIn();
      allow update: if signedIn() && canAccessRoom(rid);

      match /messages/{mid} {
        allow read: if signedIn() && canAccessRoom(rid);
        allow create: if signedIn() && canAccessRoom(rid)
                      && request.resource.data.senderId == request.auth.uid;
        allow update: if signedIn() && canAccessRoom(rid)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }

      match /calls/{cid} {
        allow read, write: if signedIn() && canAccessRoom(rid);
        match /{sub}/{doc} {
          allow read, write: if signedIn() && canAccessRoom(rid);
        }
      }
    }
  }
}
